# Server
PORT=8787
APPROVAL_KEY=replace-with-a-long-random-string

# Keep false until you have reviewed the candidate and tested dry runs.
LIVE_DEPLOY_ENABLED=false
AUTO_LAUNCH_ENABLED=false
J7_REGION=eu
J7_JWT=
J7_ENCRYPTED_SOLANA_KEY=

# Optional: route 100% of Pump creator fees to this Solana wallet.
# This is a public address only — never a seed phrase or private key.
CREATOR_FEE_WALLET=

# Defaults to no dev buy. Set only if you knowingly want capital at risk.
DEV_BUY_SOL=0

# Optional AI review. The deterministic scorer works without this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Thresholds
MIN_SCORE=72
MAX_SIGNAL_AGE_MINUTES=20
NEWS_POLL_INTERVAL_MS=60000
MAX_AI_RESEARCH_PER_BATCH=2
MAX_AI_REVIEWS_PER_HOUR=6
MAX_NEWS_AI_PER_HOUR=6
# Optional. Use a random topic name and subscribe to it in the ntfy phone app.
NTFY_TOPIC=
